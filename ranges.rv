// Internal Unicode range tables behind the width lookups in lib.rv. The wide
// set follows East Asian Width (W and F), the zero set covers the common
// combining blocks and format characters. Both are curated subsets; the
// README says what is left out.

// True when the codepoint takes two terminal columns.
fun _is_wide(cp: int) -> bool {
    if cp < 4352 {
        return false
    }
    if cp <= 4447 {
        return true
    }
    if cp == 9001 or cp == 9002 {
        return true
    }
    if cp >= 11904 and cp <= 12350 {
        return true
    }
    if cp >= 12353 and cp <= 13311 {
        return true
    }
    if cp >= 13312 and cp <= 19903 {
        return true
    }
    if cp >= 19968 and cp <= 40959 {
        return true
    }
    if cp >= 40960 and cp <= 42191 {
        return true
    }
    if cp >= 43360 and cp <= 43391 {
        return true
    }
    if cp >= 44032 and cp <= 55203 {
        return true
    }
    if cp >= 63744 and cp <= 64255 {
        return true
    }
    if cp >= 65040 and cp <= 65049 {
        return true
    }
    if cp >= 65072 and cp <= 65135 {
        return true
    }
    if cp >= 65280 and cp <= 65376 {
        return true
    }
    if cp >= 65504 and cp <= 65510 {
        return true
    }
    if cp >= 94176 and cp <= 94180 {
        return true
    }
    if cp >= 94208 and cp <= 100343 {
        return true
    }
    if cp >= 100352 and cp <= 101589 {
        return true
    }
    if cp >= 110592 and cp <= 111355 {
        return true
    }
    if cp == 126980 or cp == 127183 or cp == 127374 {
        return true
    }
    if cp >= 127377 and cp <= 127386 {
        return true
    }
    if cp >= 127488 and cp <= 127743 {
        return true
    }
    if cp >= 127744 and cp <= 128591 {
        return true
    }
    if cp >= 128640 and cp <= 128764 {
        return true
    }
    if cp >= 128992 and cp <= 129003 {
        return true
    }
    if cp >= 129292 and cp <= 129535 {
        return true
    }
    if cp >= 129648 and cp <= 129791 {
        return true
    }
    if cp >= 131072 and cp <= 196605 {
        return true
    }
    if cp >= 196608 and cp <= 262141 {
        return true
    }
    return false
}

// True when the codepoint occupies no column of its own: combining marks,
// zero width spaces and joiners, variation selectors, and the BOM.
fun _is_zero(cp: int) -> bool {
    if cp < 768 {
        return false
    }
    if cp <= 879 {
        return true
    }
    if cp >= 1155 and cp <= 1161 {
        return true
    }
    if cp >= 1425 and cp <= 1469 {
        return true
    }
    if cp == 1471 or cp == 1473 or cp == 1474 {
        return true
    }
    if cp == 1476 or cp == 1477 or cp == 1479 {
        return true
    }
    if cp >= 1552 and cp <= 1562 {
        return true
    }
    if cp >= 1611 and cp <= 1631 {
        return true
    }
    if cp == 1648 {
        return true
    }
    if cp >= 1750 and cp <= 1756 {
        return true
    }
    if cp >= 1759 and cp <= 1764 {
        return true
    }
    if cp == 1767 or cp == 1768 {
        return true
    }
    if cp >= 1770 and cp <= 1773 {
        return true
    }
    if cp >= 3633 and cp <= 3642 and cp != 3634 and cp != 3635 {
        return true
    }
    if cp >= 3655 and cp <= 3662 {
        return true
    }
    if cp >= 6832 and cp <= 6911 {
        return true
    }
    if cp >= 7616 and cp <= 7679 {
        return true
    }
    if cp >= 8203 and cp <= 8207 {
        return true
    }
    if cp >= 8234 and cp <= 8238 {
        return true
    }
    if cp == 8288 {
        return true
    }
    if cp >= 8400 and cp <= 8447 {
        return true
    }
    if cp >= 65024 and cp <= 65039 {
        return true
    }
    if cp >= 65056 and cp <= 65071 {
        return true
    }
    if cp == 65279 {
        return true
    }
    if cp >= 917760 and cp <= 917999 {
        return true
    }
    return false
}
